rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions.

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(ownerId) {
      return isAuthenticated() && request.auth.uid == ownerId;
    }

    function isOwnDoc(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    // Admins are identified by the `role` field on their own users/{uid} doc.
    // This lets admin actions work on the Spark plan without deployed Cloud
    // Functions; on Blaze the callable functions set a matching custom claim.
    function isAdmin() {
      return isAuthenticated()
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isNonEmptyString(value, maxLen) {
      return value is string
        && value.size > 0
        && value.size <= maxLen;
    }

    function isOptionalString(value, maxLen) {
      return !(value in incoming()) || (value is string && value.size <= maxLen);
    }

    function isValidUsername(name) {
      return name is string
        && name == name.lower()
        && name.matches('^[a-z0-9_]{3,20}$');
    }

    // users/{uid}
    match /users/{uid} {
      allow read: if isAdmin() || isOwnDoc(uid);

      // Critical: role and isSuspended are never client-writable.
      allow create: if isOwnDoc(uid)
        && incoming().keys().hasAll(['uid', 'email', 'username', 'firstName', 'lastName', 'age', 'skills', 'profession'])
        && incoming().uid == uid
        && isNonEmptyString(incoming().email, 254)
        && isValidUsername(incoming().username)
        && isNonEmptyString(incoming().firstName, 50)
        && isNonEmptyString(incoming().lastName, 50)
        && incoming().age is int
        && incoming().age >= 13
        && incoming().age <= 100
        && incoming().skills is list
        && incoming().skills.size() <= 20
        && incoming().profession is string
        && incoming().profession in ['student', 'employee', 'selfEmployed', 'founder', 'other']
        && (!('role' in incoming()) || incoming().role == 'user')
        && (!('isSuspended' in incoming()) || incoming().isSuspended == false);

      // Profile owners can update their own safe fields. Admins may update only
      // the role or isSuspended field. Because request.resource.data contains
      // the full resulting document, we use diff() to inspect changed keys.
      allow update: if (isOwnDoc(uid)
          && !(incoming().keys().hasAny(['role', 'isSuspended', 'uid', 'username']))
          && isNonEmptyString(incoming().displayName, 100)
          && isNonEmptyString(incoming().firstName, 50)
          && isNonEmptyString(incoming().lastName, 50)
          && incoming().age is int
          && incoming().age >= 13
          && incoming().age <= 100
          && incoming().skills is list
          && incoming().skills.size() <= 20
          && incoming().profession is string
          && incoming().profession in ['student', 'employee', 'selfEmployed', 'founder', 'other']
          && isOptionalString(incoming().bio, 500)
          && isOptionalString(incoming().photoUrl, 2048)
          && incoming().socialLinks is map
          && incoming().socialLinks.keys().hasOnly(['twitter', 'linkedin', 'website'])
          && isOptionalString(incoming().socialLinks.twitter, 2048)
          && isOptionalString(incoming().socialLinks.linkedin, 2048)
          && isOptionalString(incoming().socialLinks.website, 2048))
        || (isAdmin()
          && (
            (incoming().diff(existing()).changedKeys().hasOnly(['role']) && incoming().role in ['user', 'admin'])
            || (incoming().diff(existing()).changedKeys().hasOnly(['isSuspended']) && incoming().isSuspended is bool)
          ))
        // Any signed-in user can increment profileViews by exactly 1. This is a
        // public counter, so we allow a single-step increase without exposing
        // other fields.
        || (isAuthenticated()
          && incoming().diff(existing()).changedKeys().hasOnly(['profileViews'])
          && incoming().profileViews is int
          && incoming().profileViews == existing().profileViews + 1);

      // Only admins can delete user docs, via a Cloud Function that also removes Auth.
      allow delete: if isAdmin();
    }

    // usernames/{username}
    // One-to-one mapping from a unique username to its owner's uid. Immutable.
    match /usernames/{username} {
      // Public read so the register screen can check availability.
      allow read: if true;

      // Only the authenticated owner can claim a username, and only if the doc
      // doesn't already exist. The client transaction enforces this further.
      allow create: if isAuthenticated()
        && isValidUsername(username)
        && incoming().keys().hasOnly(['uid'])
        && incoming().uid == request.auth.uid;

      // Usernames never change or get deleted by clients, but admins can
      // release a username when deleting a user account.
      allow update: if false;
      allow delete: if isAdmin();
    }

    // projects/{projectId}
    match /projects/{projectId} {
      allow read: if isAdmin()
        || existing().ownerId == request.auth.uid
        || existing().status == 'approved';

      // Force owner and pending status on create; validate allowed values.
      allow create: if isAuthenticated()
        && incoming().ownerId == request.auth.uid
        && incoming().status == 'pending'
        && isNonEmptyString(incoming().name, 100)
        && isNonEmptyString(incoming().tagline, 160)
        && isNonEmptyString(incoming().description, 5000)
        && incoming().category is string
        && incoming().category in ['saas', 'aiTools', 'webApps', 'mobileApps', 'eCommerce', 'marketplace', 'developerTools', 'education', 'finance', 'healthcare', 'marketing', 'productivity', 'other']
        && isOptionalString(incoming().websiteUrl, 2048)
        && isOptionalString(incoming().businessAge, 50)
        && isOptionalString(incoming().monthlyVisitors, 50)
        && incoming().screenshotUrls is list
        && incoming().screenshotUrls.size() <= 10
        && incoming().documentUrls is list
        && incoming().documentUrls.size() <= 5
        && isNonEmptyString(incoming().founderName, 100)
        && isOptionalString(incoming().founderBio, 1000)
        && (!('isFeatured' in incoming()) || incoming().isFeatured == false)
        && (!('saveCount' in incoming()) || incoming().saveCount == 0)
        && (!('viewCount' in incoming()) || incoming().viewCount == 0);

      // Owners can edit content fields but never status, isFeatured, counters, or IDs.
      // Admins can update status and isFeatured for moderation.
      // Any signed-in user can increment viewCount or adjust saveCount by one
      // step (save/unsave) so counters stay in sync without deployed functions.
      allow update: if isAdmin()
        || (isOwner(existing().ownerId)
            && !(incoming().keys().hasAny(['status', 'isFeatured', 'saveCount', 'viewCount', 'ownerId', 'projectId'])))
        || (isAuthenticated()
            && incoming().diff(existing()).changedKeys().hasOnly(['viewCount'])
            && incoming().viewCount is int
            && incoming().viewCount == existing().viewCount + 1)
        || (isAuthenticated()
            && incoming().diff(existing()).changedKeys().hasOnly(['saveCount'])
            && incoming().saveCount is int
            && incoming().saveCount >= 0
            && (incoming().saveCount == existing().saveCount + 1 || incoming().saveCount == existing().saveCount - 1));

      allow delete: if isAdmin() || isOwner(existing().ownerId);
    }

    // saved_projects/{uid}_{projectId}
    match /saved_projects/{docId} {
      // Composite doc ID must be "{uid}_{projectId}".
      function belongsTo(uid) {
        return docId.matches(uid + '_.*');
      }

      allow read: if isAuthenticated() && belongsTo(request.auth.uid);

      allow create: if isAuthenticated()
        && belongsTo(request.auth.uid)
        && incoming().uid == request.auth.uid
        && incoming().projectId is string
        && incoming().projectId.size() > 0
        && docId == request.auth.uid + '_' + incoming().projectId;

      allow update: if isAuthenticated()
        && belongsTo(request.auth.uid)
        && incoming().uid == request.auth.uid
        && incoming().projectId == existing().projectId;

      allow delete: if isAuthenticated() && belongsTo(request.auth.uid);
    }

    // auditLogs/{entryId}
    match /auditLogs/{entryId} {
      // Admin-only. Actions are logged by Cloud Functions or trusted admin clients.
      allow read: if isAdmin();
      allow create: if isAdmin()
        && incoming().adminUid == request.auth.uid
        && incoming().timestamp is timestamp
        && incoming().action is string
        && incoming().targetType is string
        && incoming().targetId is string
        && incoming().targetName is string;
      allow update, delete: if false;
    }

    // rateLimits/{uid}
    match /rateLimits/{uid} {
      // Never writable by clients; Cloud Functions manage this collection.
      allow read: if isOwnDoc(uid);
      allow write: if false;
    }

    // activityLogs/{entryId}
    match /activityLogs/{entryId} {
      allow read: if isAdmin() || (isAuthenticated() && resource.data.uid == request.auth.uid);

      allow create: if isAuthenticated()
        && incoming().uid == request.auth.uid
        && incoming().action in ['login', 'project_published', 'project_edited', 'project_saved', 'project_unsaved', 'profile_updated']
        && incoming().timestamp is timestamp
        && incoming().metadata is map;

      allow update, delete: if false;
    }

    // projects/{projectId}/history/{historyEntryId}
    match /projects/{projectId}/history/{historyEntryId} {
      allow read: if isAdmin() || isOwner(get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId);

      allow create: if isAuthenticated()
        && (isAdmin() || isOwner(get(/databases/$(database)/documents/projects/$(projectId)).data.ownerId))
        && incoming().editedBy == request.auth.uid
        && incoming().timestamp is timestamp
        && incoming().changedFields is list
        && incoming().previousValues is map;

      allow update, delete: if false;
    }

    // notifications/{notificationId}
    match /notifications/{notificationId} {
      allow read: if isAuthenticated() && resource.data.userId == request.auth.uid;

      // Admins create notifications; users can only mark their own as read.
      allow create: if isAdmin()
        && incoming().userId is string
        && incoming().userId.size() > 0
        && incoming().projectId is string
        && incoming().title is string
        && incoming().body is string
        && incoming().type in ['projectApproved', 'projectRejected', 'projectRemoved']
        && incoming().isRead == false
        && incoming().timestamp is timestamp;

      allow update: if isOwnDoc(resource.data.userId)
        && incoming().keys().hasOnly(['isRead'])
        && incoming().isRead == true;

      allow delete: if false;
    }

    // Deny everything else by default.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
